---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { pageTitles } from '~/site-titles.js';

const metadata = {
  title: pageTitles.wordpressEntwickler,
  description:
    'WordPress Entwickler und PHP Freelancer in Frankfurt: Hilfe bei der kritischen PHP-Sicherheitslücke PHP2Shell (CVE-2026-109618, CVE-2026-109619). PHP-Update, Befalls-Prüfung und Bereinigung.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="WordPress Entwickler & PHP Freelancer · Akute PHP-Sicherheitslücke"
    title="WordPress Entwickler Frankfurt – PHP Freelancer gegen PHP2Shell"
    subtitle="Eine kritische Lücke im PHP-Kern bedroht weltweit Websites und Online-Shops. Als WordPress Entwickler und PHP Freelancer in Frankfurt aktualisiere ich Ihren Server, prüfe auf Befall und bereinige gehackte Seiten."
    actions={[{ variant: 'primary', target: '_blank', text: 'Jetzt Website prüfen lassen!', href: '/kontakt' }]}
  />

  <!-- Content Widgets *************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Was ist PHP2Shell?',
        description:
          'PHP2Shell bezeichnet zwei kritische Schwachstellen im PHP-Kern (CVE-2026-109618 und CVE-2026-109619). Sie ermöglichen laut Berichten die Ausführung von Code aus der Ferne, ohne dass sich ein Angreifer anmelden muss. Betroffen sind Websites jeder Art, nicht nur WordPress.',
        icon: 'tabler:bug',
      },
      {
        title: 'Warum ist das so gefährlich?',
        description:
          'PHP läuft auf rund zwei Dritteln aller Websites. Im schlimmsten Fall übernehmen Angreifer den ganzen Server: Sie greifen Kundendaten ab, stören Zahlungen oder missbrauchen den Server für weitere Angriffe. Es wurden bereits erste Angriffe beobachtet.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'Was jetzt zu tun ist',
        description:
          'PHP auf eine gepatchte Version aktualisieren (8.5.12, 8.4.27, 8.3.36 oder 8.2.35), die PHP-Prozesse neu starten und prüfen, ob die Seite schon kompromittiert wurde. Ältere Versionen wie PHP 5 und 7 werden laut Berichten nicht mehr gepatcht und müssen auf eine aktuelle Version umziehen.',
        icon: 'tabler:shield-check',
      },
    ]}
    image={{
      src: '/images/suchmaschinenmarketing-in-frankfurt.jpg',
      alt: 'PHP2Shell Sicherheitslücke: Website-Absicherung in Frankfurt',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Die PHP-Sicherheitslücke betrifft auch Ihre Website
      </h3>
    </Fragment>
  </Content>

  <Content
    isReversed
    items={[
      {
        title: '1. Sofort-Check',
        description:
          'Ich prüfe, welche PHP-Version bei Ihnen läuft, ob Ihr Hoster bereits gepatcht hat und ob es Hinweise auf einen Angriff gibt: unbekannte PHP-Dateien, neue Benutzer, auffällige Logs.',
        icon: 'tabler:zoom-check',
      },
      {
        title: '2. Update & Absicherung',
        description:
          'Ich spiele das PHP-Update ein beziehungsweise veranlasse es beim Hoster, starte die PHP-Prozesse neu und teste, dass Ihre Website, Plugins und Shop danach einwandfrei laufen. Falls ein Update nicht sofort möglich ist, richte ich Übergangsschutz auf Webserver-Ebene ein.',
        icon: 'tabler:refresh',
      },
      {
        title: '3. Bereinigung & Härtung',
        description:
          'Ist die Seite bereits befallen, entferne ich Webshells und Hintertüren, ändere alle Zugangsdaten, stelle bei Bedarf aus einem sauberen Backup wieder her und richte Monitoring ein.',
        icon: 'tabler:lock',
      },
    ]}
    image={{
      src: '/images/suchmaschinenmarketing-in-frankfurt-2.jpg',
      alt: 'PHP Update und Bereinigung durch PHP Freelancer in Frankfurt',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">So behebe ich das Problem für Sie</h3>
    </Fragment>
  </Content>

  <!-- Features3 Widget ************** -->

  <Features3
    title="PHP2Shell – Meine Leistungen"
    subtitle="Schnelle Hilfe für Unternehmen im Rhein-Main-Gebiet"
    columns={2}
    items={[
      {
        title: 'PHP-Update auf gepatchte Version',
        description:
          'Auf Ihrem Server oder in Abstimmung mit Ihrem Hoster, inklusive Test von WordPress, WooCommerce, Plugins und eigenem Code.',
        icon: 'tabler:brand-php',
      },
      {
        title: 'Kompatibilität sicherstellen',
        description:
          'Läuft Ihre Seite noch auf einer alten PHP-Version, migriere ich Theme und Plugins auf eine aktuelle Version und behebe Fehler und Deprecation-Warnungen.',
        icon: 'tabler:code',
      },
      {
        title: 'Befalls-Prüfung',
        description:
          'Suche nach Webshells, manipulierten Dateien, fremden Administratoren und verdächtigen Cronjobs, damit Sie wissen, ob Sie betroffen waren.',
        icon: 'tabler:search',
      },
      {
        title: 'Malware-Entfernung',
        description:
          'Gründliche Bereinigung gehackter WordPress-Seiten, inklusive Blacklist-Entfernung bei Google, wenn Ihre Seite markiert wurde.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Übergangsschutz',
        description:
          'Wenn das Update nicht sofort möglich ist, sichere ich den Webserver mit Regeln ab, etwa durch das Einschränken von Datei-Uploads, bis der Patch eingespielt ist.',
        icon: 'tabler:shield-half',
      },
      {
        title: 'Wartungsvertrag',
        description:
          'Regelmäßige Updates für PHP, WordPress und Plugins sowie Monitoring, damit Sie bei der nächsten Lücke nicht erst aus der Zeitung davon erfahren.',
        icon: 'tabler:tool',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="PHP2Shell – häufige Fragen"
    subtitle="Die wichtigsten Antworten zur aktuellen PHP-Sicherheitslücke."
    columns={1}
    items={[
      {
        title: 'Ist meine Website betroffen?',
        description:
          'Wenn Ihre Website mit PHP läuft, was bei WordPress, WooCommerce, Joomla, Drupal, Typo3 und vielen Shops der Fall ist, ist sie grundsätzlich betroffen, solange PHP auf dem Server nicht aktualisiert wurde. Ich prüfe das gerne für Sie.',
      },
      {
        title: 'Muss ich WordPress oder meine Plugins aktualisieren?',
        description:
          'Die Lücke liegt in PHP selbst, nicht in WordPress. Entscheidend ist das PHP-Update auf dem Server. Updates von WordPress und Plugins sind trotzdem sinnvoll und können bei einer neuen PHP-Version nötig sein.',
      },
      {
        title: 'Ich bin bei einem Hoster. Muss ich selbst etwas tun?',
        description:
          'Bei Shared Hosting kümmert sich meist der Hoster. Prüfen Sie im Kundenmenü, welche PHP-Version aktiv ist, und fragen Sie nach, ob der Patch eingespielt wurde. Bei VPS und Root-Servern müssen Sie selbst aktualisieren. Dabei helfe ich.',
      },
      {
        title: 'Reicht das Update, wenn ich schon angegriffen wurde?',
        description:
          'Nein. Das Update schließt die Lücke, entfernt aber keine Hintertüren, die bereits installiert wurden. Deshalb sollte nach dem Update immer geprüft werden, ob ein Befall vorliegt.',
      },
      {
        title: 'Was kostet die Absicherung?',
        description:
          'Ein Sofort-Check und ein PHP-Update sind meist in wenigen Stunden erledigt. Ich rechne nach Aufwand ab und nenne Ihnen vorab eine realistische Einschätzung. Größere Bereinigungen biete ich zum Festpreis an.',
      },
      {
        title: 'Arbeiten Sie auch außerhalb von Frankfurt?',
        description:
          'Ja, die meisten Einsätze laufen remote. Im Rhein-Main-Gebiet komme ich bei Bedarf auch persönlich vorbei.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Jetzt anfragen!',
        href: '/kontakt',
      },
    ]}
    title="Wissen Sie, ob Ihre Website sicher ist?"
    subtitle="Schreiben Sie mir. Ich prüfe Ihre PHP-Version, spiele den Patch ein und bereinige bei Bedarf. Ihr WordPress Entwickler und PHP Freelancer aus Frankfurt."
  />
</Layout>
